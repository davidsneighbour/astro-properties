---
import type { LightboxImage } from "../lib/lightbox.js";
import Lightbox from "./Lightbox.astro";

interface Props {
  images: LightboxImage[];
  class?: string | undefined;
}

const { images, class: className } = Astro.props;
const galleryId = `gallery-${crypto.randomUUID().slice(0, 8)}`;
---

{
  images.length > 0 && (
    <>
      <div
        class:list={["gallery", "grid grid-cols-2 gap-2 sm:grid-cols-3", className]}
        data-gallery={galleryId}
      >
        {images.map((image, index) => (
          <button
            type="button"
            class="aspect-video overflow-hidden rounded"
            data-lightbox-trigger={galleryId}
            data-lightbox-index={index}
          >
            <img src={image.src} alt={image.alt} class="h-full w-full object-cover" />
          </button>
        ))}
      </div>
      <Lightbox id={galleryId} images={images} />
    </>
  )
}
