---
import type { LightboxImage } from "../lib/lightbox.js";

interface Props {
  id: string;
  images: LightboxImage[];
  class?: string | undefined;
}

const { id, images, class: className } = Astro.props;
---

<div
  class:list={[
    "lightbox",
    "fixed inset-0 z-50 hidden items-center justify-center bg-black/80",
    className,
  ]}
  data-lightbox={id}
  data-lightbox-images={JSON.stringify(images)}
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <button type="button" data-lightbox-close aria-label="Close" class="absolute right-4 top-4 text-white">
    &#10005;
  </button>
  <button type="button" data-lightbox-prev aria-label="Previous image" class="absolute left-4 text-white">
    &#8249;
  </button>
  <img data-lightbox-image alt="" class="max-h-[80vh] max-w-[80vw] object-contain" />
  <button type="button" data-lightbox-next aria-label="Next image" class="absolute right-4 text-white">
    &#8250;
  </button>
</div>

<script>
  import {
    closeLightbox,
    createLightboxState,
    currentLightboxImage,
    type LightboxState,
    openLightbox,
    stepLightbox,
  } from "../lib/lightbox.js";

  const states = new Map<string, LightboxState>();

  function render(root: HTMLElement, state: LightboxState) {
    const img = root.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const current = currentLightboxImage(state);
    if (img && current) {
      img.src = current.src;
      img.alt = current.alt;
    }
    root.classList.toggle("hidden", !state.isOpen);
    root.classList.toggle("flex", state.isOpen);
    root.setAttribute("aria-hidden", state.isOpen ? "false" : "true");
  }

  function getRoot(id: string): HTMLElement | null {
    return document.querySelector<HTMLElement>(`[data-lightbox="${id}"]`);
  }

  function getState(id: string): LightboxState {
    const existing = states.get(id);
    if (existing) return existing;
    const root = getRoot(id);
    const images = root ? JSON.parse(root.dataset.lightboxImages ?? "[]") : [];
    const state = createLightboxState(images);
    states.set(id, state);
    return state;
  }

  function setState(id: string, state: LightboxState) {
    states.set(id, state);
    const root = getRoot(id);
    if (root) render(root, state);
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;

    const trigger = target.closest<HTMLElement>("[data-lightbox-trigger]");
    if (trigger) {
      const id = trigger.dataset.lightboxTrigger ?? "";
      const index = Number(trigger.dataset.lightboxIndex ?? "0");
      setState(id, openLightbox(getState(id), index));
      return;
    }

    const root = target.closest<HTMLElement>("[data-lightbox]");
    if (!root) return;
    const id = root.dataset.lightbox ?? "";

    if (target.closest("[data-lightbox-close]")) {
      setState(id, closeLightbox(getState(id)));
    } else if (target.closest("[data-lightbox-prev]")) {
      setState(id, stepLightbox(getState(id), -1));
    } else if (target.closest("[data-lightbox-next]")) {
      setState(id, stepLightbox(getState(id), 1));
    }
  });

  document.addEventListener("keydown", (event) => {
    const openRoot = document.querySelector<HTMLElement>("[data-lightbox]:not(.hidden)");
    if (!openRoot) return;
    const id = openRoot.dataset.lightbox ?? "";

    if (event.key === "Escape") setState(id, closeLightbox(getState(id)));
    if (event.key === "ArrowLeft") setState(id, stepLightbox(getState(id), -1));
    if (event.key === "ArrowRight") setState(id, stepLightbox(getState(id), 1));
  });
</script>
