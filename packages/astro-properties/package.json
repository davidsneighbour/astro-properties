{
  "name": "@davidsneighbour/astro-properties",
  "version": "0.1.0",
  "description": "Property-sales features (schemas, components, layouts, search) for Astro sites.",
  "license": "MIT",
  "type": "module",
  "author": "Patrick Kollitsch",
  "homepage": "https://github.com/davidsneighbour/astro-properties",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/astro-properties.git",
    "directory": "packages/astro-properties"
  },
  "bugs": "https://github.com/davidsneighbour/astro-properties/issues",
  "keywords": [
    "astro-component",
    "astro-integration",
    "withastro",
    "real-estate",
    "properties"
  ],
  "exports": {
    ".": "./src/schema.ts",
    "./schema": "./src/schema.ts",
    "./content-schema": "./src/content-schema.ts",
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./lib/*": "./src/lib/*"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "peerDependencies": {
    "astro": ">=7.0.0"
  },
  "dependencies": {
    "fast-glob": "3.3.3",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "leaflet-geosearch": "4.4.0",
    "leaflet.markercluster": "1.5.3",
    "smol-toml": "1.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dnbhq/release-config": "1.1.0",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/leaflet": "1.9.21",
    "@types/leaflet-draw": "1.0.13",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "astro": "7.0.7",
    "release-it": "20.2.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  }
}
