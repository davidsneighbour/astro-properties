---
import ListingLayout from "@davidsneighbour/astro-properties/layouts/ListingLayout.astro";
import "../../styles/global.css";
import { getCollection } from "astro:content";
import { SearchFilters } from "../../components/SearchFilters";

const properties = await getCollection("properties");
const listings = properties.map((entry) => ({
  href: `/properties/${entry.id}`,
  title: entry.data.title,
  price: entry.data.price,
  coverImageSrc: entry.data.coverImage.src,
  coverImageAlt: entry.data.title,
  bedrooms: entry.data.bedrooms,
  bathrooms: entry.data.bathrooms,
  areaSize: entry.data.areaSize,
  areaUnit: entry.data.areaUnit,
  labels: entry.data.labels,
}));

function sortedUnique<T>(values: T[]): T[] {
  return [...new Set(values)].sort();
}

const types = sortedUnique(properties.map((entry) => entry.data.type));
const statuses = sortedUnique(properties.map((entry) => entry.data.status));
const categories = sortedUnique(properties.map((entry) => entry.data.category));
const locations = sortedUnique(properties.map((entry) => entry.data.location.city));
const bedOptions = sortedUnique(
  properties
    .map((entry) => entry.data.bedrooms)
    .filter((beds): beds is number => beds != null),
).sort((a, b) => a - b);
---

<ListingLayout title="All properties — Astro Properties demo" listings={listings}>
  <Fragment slot="intro">
    <SearchFilters
      client:load
      types={types}
      statuses={statuses}
      categories={categories}
      locations={locations}
      bedOptions={bedOptions}
    />
  </Fragment>
</ListingLayout>
