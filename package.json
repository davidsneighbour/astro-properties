{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "Patrick Kollitsch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/astro-properties.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "dev": "npm run dev --workspace apps/demo",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:markdown": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc \"**/*.{md,mdx}\" \"!**/node_modules/**\" \"!**/dist/**\" \"!**/.astro/**\" \"!astro-properties-roadmap.md\"",
    "lint:markdown:fix": "markdownlint-cli2 --config ./node_modules/@dnbhq/markdownlint-config/.markdownlint-cli2.jsonc --fix \"**/*.{md,mdx}\" \"!**/node_modules/**\" \"!**/dist/**\" \"!**/.astro/**\" \"!astro-properties-roadmap.md\"",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@dnbhq/biome-config": "0.2.3",
    "@dnbhq/markdownlint-config": "0.2.11",
    "@dnbhq/tsconfig": "0.1.6",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
